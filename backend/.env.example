# Servidor
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
LOG_LEVEL=info
# Proxies delante de la API (balanceador o CDN); en producción suele ser 1 (RNF03)
TRUST_PROXY=0

# Base de datos (PostgreSQL + Prisma). Coincide con docker-compose.yml
DATABASE_URL="postgresql://aventura:aventura@localhost:5433/aventura360?schema=public"

# Sesiones (RNF04)
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# OAuth 2.0 Google (RF02, UC07)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Mercado Pago (RF29-RF31, UC09)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Servicio de correo (UC14, UC15)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Aventura 360 <no-reply@aventura360.com.ar>"

# Contraseñas (RNF05)
BCRYPT_ROUNDS=12

# Contacto (RF46)
CONTACT_PHONE=
