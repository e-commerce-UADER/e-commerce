# Servidor
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Base de datos (PostgreSQL + Prisma)
DATABASE_URL="postgresql://usuario:password@localhost:5432/aventura360?schema=public"

# Sesiones y tokens (RNF04, RNF07)
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
EMAIL_TOKEN_EXPIRES_IN=24h
RESET_TOKEN_EXPIRES_IN=1h

# OAuth 2.0 Google (RF02, UC07)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Mercado Pago (RF31-RF33, UC11)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Servicio de correo (UC05, UC08, UC16, UC17)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Aventura 360 <no-reply@aventura360.com.ar>"

# Seguridad (RNF06)
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Contacto (RF48)
CONTACT_PHONE=
